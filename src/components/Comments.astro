<details class="comments-shell">
  <summary>打开评论区 <span aria-hidden="true">↘</span></summary>
  <div class="comments-target" data-giscus-target>
    <p class="comments-note">评论区由 GitHub Discussions 提供，打开后才会加载第三方内容。</p>
  </div>
</details>

<script>
  const shell = document.querySelector<HTMLDetailsElement>('.comments-shell');
  const target = shell?.querySelector<HTMLElement>('[data-giscus-target]');

  shell?.addEventListener('toggle', () => {
    if (!shell.open || !target || target.dataset.loaded) return;

    const note = target.querySelector('.comments-note');
    note?.remove();

    const script = document.createElement('script');
    script.src = 'https://giscus.app/client.js';
    script.setAttribute('data-repo', 'weufhsos/weufhsos.github.io');
    script.setAttribute('data-repo-id', 'R_kgDOQ9e3NQ');
    script.setAttribute('data-category-id', 'DIC_kwDOQ9e3Nc4C1MKV');
    script.setAttribute('data-mapping', 'pathname');
    script.setAttribute('data-reactions-enabled', '1');
    script.setAttribute('data-theme', document.documentElement.dataset.theme === 'dark' ? 'dark' : 'light');
    script.setAttribute('crossorigin', 'anonymous');
    script.async = true;
    target.append(script);
    target.dataset.loaded = 'true';
  });
</script>
