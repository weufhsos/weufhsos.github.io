---
import { getCollection } from 'astro:content';
import BaseLayout from '../layouts/BaseLayout.astro';
import PostListItem from '../components/PostListItem.astro';
import ProjectCard from '../components/ProjectCard.astro';
import { site } from '../data/site';

const posts = (await getCollection('posts', ({ data }) => !data.draft))
  .sort((a, b) => b.data.pubDate.valueOf() - a.data.pubDate.valueOf());
const projects = (await getCollection('projects', ({ data }) => data.featured))
  .sort((a, b) => a.data.order - b.data.order);
const featuredPost = posts.find((post) => post.data.featured) ?? posts[0];
const recentPosts = posts.filter((post) => post.id !== featuredPost?.id).slice(0, 3);
---

<BaseLayout>
  <section class="hero container">
    <div class="hero-copy">
      <p class="eyebrow"><span class="eyebrow-dot"></span> Independent notes / 2026</p>
      <h1>把想法<br /><em>做成作品。</em></h1>
      <p class="hero-intro">{site.intro} 关注 AI Agent、自动化工具与那些让软件更可靠的细节。</p>
      <div class="hero-actions">
        <a class="button button-primary" href="/projects/">浏览项目 <span aria-hidden="true">↗</span></a>
        <a class="button button-quiet" href="/about/">了解我 <span aria-hidden="true">↓</span></a>
      </div>
    </div>
    <div class="hero-art" aria-hidden="true">
      <div class="hero-art-grid"></div>
      <div class="hero-art-orbit hero-art-orbit-one"></div>
      <div class="hero-art-orbit hero-art-orbit-two"></div>
      <div class="hero-art-core"><span>a</span></div>
      <span class="hero-art-label hero-art-label-top">BUILD / THINK / SHARE</span>
      <span class="hero-art-label hero-art-label-bottom">01—∞</span>
    </div>
  </section>

  <section class="section container focus-section" aria-labelledby="focus-title">
    <div class="section-heading">
      <p class="eyebrow">01 / 当前关注</p>
      <h2 id="focus-title">在复杂的问题里，<br /><span>寻找简单的下一步。</span></h2>
    </div>
    <div class="focus-copy">
      <p>这里不是一份静态简历，而是一张持续更新的工作台。项目、文章和失败记录会一起留下，方便回头看见思路是怎样变清楚的。</p>
      <a class="text-link" href="/about/">更多关于我 <span aria-hidden="true">↗</span></a>
    </div>
  </section>

  {projects.length > 0 && (
    <section class="section container" aria-labelledby="projects-title">
      <div class="section-heading section-heading-row">
        <div>
          <p class="eyebrow">02 / 精选项目</p>
          <h2 id="projects-title">正在构建的东西</h2>
        </div>
        <a class="text-link" href="/projects/">查看全部 <span aria-hidden="true">↗</span></a>
      </div>
      <div class="projects-grid">
        {projects.slice(0, 3).map((project) => <ProjectCard project={project} />)}
      </div>
    </section>
  )}

  {featuredPost && (
    <section class="section container notes-section" aria-labelledby="notes-title">
      <div class="section-heading section-heading-row">
        <div>
          <p class="eyebrow">03 / 最近记录</p>
          <h2 id="notes-title">一些值得留下的笔记</h2>
        </div>
        <a class="text-link" href="/posts/">进入文章页 <span aria-hidden="true">↗</span></a>
      </div>
      <div class="notes-layout">
        <PostListItem post={featuredPost} featured />
        <div class="recent-posts-list">
          {recentPosts.map((post) => <PostListItem post={post} />)}
        </div>
      </div>
    </section>
  )}

  <section class="closing-band">
    <div class="container closing-band-inner">
      <p class="eyebrow">保持联系</p>
      <p class="closing-copy">如果你也在思考相似的问题，<a href={site.github} target="_blank" rel="noreferrer">欢迎在 GitHub 找我</a>。</p>
      <span class="closing-mark" aria-hidden="true">✳</span>
    </div>
  </section>
</BaseLayout>
